	end
	
	local MIN_SPEED = 0
	local MAX_SPEED = 150
	local value = 16
	
	local GREEN = "#4CD04B"
	
	local player = Players.LocalPlayer
	local dragging = false
	local baseKnobSize = 14 -- размер шарика без увеличения (UIScale меняет AbsoluteSize)
	
