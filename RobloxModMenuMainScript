local function C_3()
local script = G2L["3"];
	local Players = game:GetService("Players")
	local UserInputService = game:GetService("UserInputService")
	
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")
	local modMenu = script.Parent
	
	local SOUND_ID = "rbxassetid://131060925555242"
	local SOUND_VOLUME = 1
	local DEBOUNCE = 0.15 -- звук успевает прозвучать целиком, не обрывается на середине
	
	local lastPlay = 0
	
	-- ОДИН переиспользуемый звук: просто перезапускаем его при нажатии.
	-- Никаких создаваемых на лету инстансов — нечему накладываться.
	local clickSound = Instance.new("Sound")
	clickSound.SoundId = SOUND_ID
	clickSound.Volume = SOUND_VOLUME
	clickSound.Parent = game:GetService("SoundService")
	
	local function playClick()
		local now = os.clock()
		if now - lastPlay < DEBOUNCE then
			return
		end
		lastPlay = now
		clickSound.TimePosition = 0
		clickSound:Play()
	end
	
	-- Проверяем, находится ли элемент под курсором/пальцем внутри нашего меню
	-- и является ли он интерактивным (кнопка или ползунок).
	local function isInteractive(instance)
		if not instance:IsDescendantOf(modMenu) then
			return false
		end
		if instance:IsA("GuiButton") then
			return true
		end
		return instance.Name == "Track" or instance.Name == "Knob"
	end
	
	-- Один общий обработчик на все нажатия: находим, что находится под точкой
	-- нажатия, и проигрываем звук ОДИН раз, сколько бы кнопок там ни было
	-- наложено друг на друга.
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		local guis = playerGui:GetGuiObjectsAtPosition(input.Position.X, input.Position.Y)
		for _, gui in guis do
			if isInteractive(gui) then
				playClick()
				return
			end
		end
	end)
end;
