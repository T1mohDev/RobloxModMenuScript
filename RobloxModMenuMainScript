-- Require G2L wrapper
local G2L_REQUIRE = require;
local G2L_MODULES = {};
local function require(Module:ModuleScript)
    local ModuleState = G2L_MODULES[Module];
    if ModuleState then
        if not ModuleState.Required then
            ModuleState.Required = true;
            ModuleState.Value = ModuleState.Closure();
        end
        return ModuleState.Value;
    end;
    return G2L_REQUIRE(Module);
end

G2L_MODULES[G2L["2"]] = {
Closure = function()
    local script = G2L["2"];local TweenService = game:GetService("TweenService")

local toast = script.Parent:WaitForChild("Toast")

local APPEAR_TIME = 0.5 -- появление
local HOLD_TIME = 0.85 -- удержание
local FADE_TIME = 0.7 -- исчезновение

local currentToken = 0

-- Показывает тост с текстом message.
-- Если тост уже виден — заменяет текст и перезапускает анимацию.
local function showToast(message: string)
	currentToken += 1
	local token = currentToken

	toast.Text = message
	toast.Visible = true
	-- стартовое состояние: полностью прозрачная
	toast.TextTransparency = 1
	toast.BackgroundTransparency = 1

	-- появление: прозрачность -> 0, небольшой подъём вверх
	local appearInfo = TweenInfo.new(APPEAR_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local appearTween = TweenService:Create(toast, appearInfo, {
		TextTransparency = 0,
		BackgroundTransparency = 0,
	})
	appearTween:Play()

	task.delay(HOLD_TIME + APPEAR_TIME, function()
		-- если за это время показали новый тост — не трогаем старый
		if token ~= currentToken then
			return
		end
		local fadeInfo = TweenInfo.new(FADE_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		local fadeTween = TweenService:Create(toast, fadeInfo, {
			TextTransparency = 1,
			BackgroundTransparency = 1,
		})
		fadeTween:Play()
		fadeTween.Completed:Wait()
		if token == currentToken then
			toast.Visible = false
		end
	end)
end

return {
	show = showToast,
}
end;
