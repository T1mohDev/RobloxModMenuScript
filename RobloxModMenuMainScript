	local knobScale = Instance.new("UIScale")
	knobScale.Scale = 1
	knobScale.Parent = knob
	
	local GROW_SCALE = 1.15
	local function growTo(target)
		knobScale.Scale = target
	end
	
	local MIN_SPEED = 0
	local MAX_SPEED = 200
	local value = 50
	
	local GREEN = "#4CD04B"
	
	local player = Players.LocalPlayer
	local dragging = false
	local baseKnobSize = 14 -- размер шарика без увеличения (UIScale меняет AbsoluteSize)
	
